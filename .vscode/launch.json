{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Chrome (no-CORS)",
            "request": "launch",
            "type": "dart",
            // --- ¡ESTA ES LA SECCIÓN CORREGIDA! ---
            "args": [
                "--web-browser-flag",
                "--disable-web-security"
            ]
        },
        {
            "name": "CPM (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "CPM (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}